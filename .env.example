# Copy to .env.local and fill in. Free key: https://carto.com/basemaps/apikey
# Carto watermarks tiles without a key. Set either name on Render (available at
# runtime is enough — /api/basemap reads it). Tile URLs use ?key= not ?api_key=.
NEXT_PUBLIC_CARTO_API_KEY=
# CARTO_API_KEY=

# Optional — Neon pooled URI for project falling-darkness-05470105 (production branch).
# When set, the planning catalog is stored in Postgres instead of store.json.
# Set on Render from the Neon console; do not commit real URIs.
# DATABASE_URL=
