    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Duplicate the current scenario into a branch named Climate-first."
      }
    ],
    "expectedCall": [
      {
        "functionName": "create_scenario_branch",
        "arguments": {
          "projectId": { "$type": "string" },
          "name": { "$contains": "Climate" }
        }
      }
    ]
  },
  {
    "name": "Emergency shelter objective",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Start a project to identify three emergency shelter locations that maximize population coverage and avoid flood-risk areas."
