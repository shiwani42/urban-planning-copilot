          },
          {
            "functionName": "run_analysis",
            "arguments": {
              "projectId": { "$type": "string" },
              "scenarioId": { "$type": "string" }
            }
          },
          {
            "unordered": [
              {
                "functionName": "list_candidates",
                "arguments": { "projectId": { "$type": "string" } }
              },
              {
                "functionName": "inspect_candidate",
                "arguments": {
                  "projectId": { "$type": "string" },
                  "candidateId": { "$type": "string" }
                }
              }
            ]
          },
          {
            "functionName": "set_transit_threshold",
            "arguments": { "meters": 500 }
          },
          {
            "functionName": "run_analysis",
            "arguments": {
              "projectId": { "$type": "string" },
              "scenarioId": { "$type": "string" }
            }
          }
        ]
      }
    ]
  },
  {
    "name": "Check dataset freshness and limitations",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "What datasets are we using, and what are their limitations?"
      }
