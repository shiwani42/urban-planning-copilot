      {
        "functionName": "run_analysis",
        "arguments": {
          "projectId": { "$type": "string" },
          "scenarioId": { "$type": "string" }
        }
      }
    ]
  },
  {
    "name": "Change priority weights toward flood resilience",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Change priorities to transit 20%, capacity 20%, flood resilience 60% and rerun ranking."
      }
    ],
    "expectedCall": [
      {
        "functionName": "set_priority_weights",
        "arguments": {
          "projectId": { "$type": "string" },
          "scenarioId": { "$type": "string" },
          "weights": { "$any": true }
