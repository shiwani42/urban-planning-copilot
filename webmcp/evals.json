  {
    "name": "End-to-end housing journey (ordered)",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Create a North River housing project for 2,000 homes near transit outside flood zones, review the plan, run analysis, inspect the top candidate, then tighten transit to 500m and recalculate."
