[
  {
    "name": "Start housing capacity project from natural language",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Create a project called North River Housing Strategy to identify areas for 2,000 additional homes within 800m of transit, outside high-risk flood zones, respecting residential zoning."
      }
    ],
    "expectedCall": [
      {
        "functionName": "start_planning_project",
        "arguments": {
          "name": { "$contains": "North River" },
          "objectiveText": { "$contains": "2,000" }
        }
      }
    ]
  },
  {
    "name": "Review analysis plan before running",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Show me the structured analysis plan for this project before we run anything."
      }
    ],
    "expectedCall": [
      {
        "functionName": "get_analysis_plan",
        "arguments": {
          "projectId": { "$type": "string" }
        }
      }
    ]
  },
  {
    "name": "Run spatial analysis",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Run the spatial analysis for the active scenario."
      }
    ],
    "expectedCall": [
      {
        "functionName": "run_analysis",
        "arguments": {
          "projectId": { "$type": "string" },
          "scenarioId": { "$type": "string" }
        }
      }
    ]
  },
  {
    "name": "Inspect candidate evidence",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Why is the top candidate recommended? Show metrics and provenance."
      }
    ],
    "expectedCall": [
      {
        "functionName": "list_candidates",
        "arguments": {
          "projectId": { "$type": "string" }
        }
      },
      {
        "functionName": "inspect_candidate",
        "arguments": {
          "projectId": { "$type": "string" },
          "candidateId": { "$type": "string" }
        }
      }
    ]
  },
  {
    "name": "Tighten transit threshold to 500m",
    "messages": [
      {
        "role": "user",
        "type": "message",
